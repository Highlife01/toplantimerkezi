# Toplantı Merkezi — Ortam Değişkenleri Şablonu (.env.example)
# Bu dosyayı .env olarak kopyalayıp gerçek değerleri giriniz.

# Firebase Web Yapılandırması (Firebase Console -> Project Settings -> General -> Web App)
VITE_FIREBASE_API_KEY=AIzaSyYourActualApiKeyHere123456789
VITE_FIREBASE_AUTH_DOMAIN=toplantimerkezi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=toplantimerkezi
VITE_FIREBASE_STORAGE_BUCKET=toplantimerkezi.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=102938475600
VITE_FIREBASE_APP_ID=1:102938475600:web:abcdef1234567890abcdef

# Google Analytics 4 (Örn: G-XXXXXXXXXX)
VITE_GA_ID=G-TOPLANTIMERKEZI

# E-Posta & SMS Webhook / Notification Endpoints (Opsiyonel)
VITE_EMAIL_WEBHOOK_URL=
VITE_SMS_WEBHOOK_URL=
