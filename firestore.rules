rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Yardımcı fonksiyonlar: Admin kontrolü
    function isAdmin() {
      return request.auth != null;
    }
    
    // Teklif Talepleri (leads)
    // Ziyaretçiler sadece geçerli şirket ve telefon bilgisiyle talep oluşturabilir (create).
    // Tüm müşteri veritabanını toplu çekmek (list) kesinlikle kamuya KAPALIDIR (KVKK koruması).
    // Ziyaretçi yalnızca elindeki benzersiz takip koduyla doğrudan tekil dokümanı okuyabilir (get).
    // Güncelleme ve silme yalnızca yetkili yöneticilere aittir.
    match /leads/{leadId} {
      allow create: if request.resource.data.company != null 
                    && request.resource.data.phone != null;
      allow get: if true;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }
    
    // Sistem Ayarları (settings)
    // Hassas admin PIN, CRM ayarları ve API bilgileri kamuya kapalıdır.
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
    
    // Tedarikçiler (suppliers)
    // Tedarikçi listesi, özel fiyat seviyeleri ve iletişimler iç CRM verisidir.
    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }
    
    // Mekânlar (venues)
    // Ziyaretçiler salon ve otel kataloğunu görüntüleyebilir.
    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // SEO Sayfaları (seo_pages)
    match /seo_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Yönlendirmeler (redirects)
    match /redirects/{redirectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Bildirim Günlükleri (notification_logs)
    match /notification_logs/{logId} {
      allow create, read, update, delete: if isAdmin();
    }
  }
}
